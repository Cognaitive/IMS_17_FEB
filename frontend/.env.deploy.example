# Copy to .env.deploy (gitignored) — Hostinger FTP for inventory.samaywatch.in
# hPanel → Files → FTP Accounts
HOSTINGER_FTP_HOST=ftp.samaywatch.in
HOSTINGER_FTP_USER=
HOSTINGER_FTP_PASSWORD=
# Subdomain root for inventory.samaywatch.in (confirm in hPanel File Manager)
HOSTINGER_FTP_REMOTE_DIR=public_html
HOSTINGER_FTP_PORT=21
HOSTINGER_FTP_SECURE=false
