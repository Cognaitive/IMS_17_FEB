# Copy to .env.deploy (gitignored) and fill with Hostinger FTP details from hPanel.
# hPanel → Files → FTP Accounts (or Websites → Manage → FTP)

HOSTINGER_FTP_HOST=ftp.yourdomain.com
HOSTINGER_FTP_USER=u123456789
HOSTINGER_FTP_PASSWORD=your-ftp-password

# Optional — defaults shown
# HOSTINGER_FTP_REMOTE_DIR=public_html
# HOSTINGER_FTP_PORT=21
# HOSTINGER_FTP_SECURE=false
